-  // ── Detonation ─────────────────────────────────────────────────────────────
-
-  private updateFuses(time: number): void {
-    if (!this.marks.some((m) => m.fuseAt > 0 && time >= m.fuseAt)) return;
-    const going = this.marks.filter((m) => m.fuseAt > 0 && time >= m.fuseAt);
-    this.marks = this.marks.filter((m) => !(m.fuseAt > 0 && time >= m.fuseAt));

-    if (s.session) return TONE[s.session.kind];
-    if (s.mpOn) return TONE[s.mpChalk];
-    return CHK.white;
-  }
-
-  // ── Lifecycle ──────────────────────────────────────────────────────────────
-
-  reset(): void {

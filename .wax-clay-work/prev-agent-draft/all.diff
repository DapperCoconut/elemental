-    for (let i = 0; i < n; i++) {
-      const a = spin + (i / n) * Math.PI * 2;
-      const cx = x + Math.cos(a) * rr;
-      const cy = y + Math.sin(a) * rr * 0.86;
-      const w = 7 - ring * 1.4;
-      g.fillStyle(tint(ring === 0 ? MAG.scaleDeep : MAG.scale), alpha * 0.9);

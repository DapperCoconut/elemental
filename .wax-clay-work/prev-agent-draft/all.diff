+/** Chalk was replaced outright by Clay. Unlike the historical Quantum rename, `chalk` is no
+ * longer a live id, so this migration is safely idempotent and can repair every old save without
+ * adding another permanent version flag. */
+function migrateChalkToClay(d: SaveData): boolean {
+  const OLD = 'chalk';
+  const NEW = 'clay';
+  let changed = false;
+  const records: Array<Record<string, unknown>> = [
+    d.owned, d.active, d.unlockedPerks, d.equippedPerks, d.masteryProgress,
+    d.masteryEnabled, d.masteryBinds, d.equippedSkins, d.paperJournal, d.deathsByElement,
+  ];
+  for (const rec of records) {
+    if (!(OLD in rec)) continue;
+    if (!(NEW in rec)) rec[NEW] = rec[OLD];
+    delete rec[OLD];
+    changed = true;
+  }
+  const renameList = (list: string[]): void => {
+    for (let i = list.length - 1; i >= 0; i--) {
+      if (list[i] !== OLD) continue;
+      if (list.includes(NEW)) list.splice(i, 1);
+      else list[i] = NEW;
+      changed = true;
+    }
+  };
+  for (const list of [d.unlockedElements, d.gauntletsCompleted, d.gauntletsCompletedHard, d.quantumBond]) renameList(list);
+  if (d.pendingUnstable) {
+    if (d.pendingUnstable.result === OLD) { d.pendingUnstable.result = NEW; changed = true; }
+    renameList(d.pendingUnstable.ingredients);
+  }
+  return changed;
+}
+
+/** Magma was replaced outright by Wax. The unlock and match history survive; the retired
+ * Magma upgrades and mastery do not become accidental Wax purchases. */
+function migrateMagmaToWax(d: SaveData): boolean {
+  const OLD = 'magma';
+  const NEW = 'wax';
+  let changed = false;
+  for (const rec of [d.paperJournal, d.deathsByElement, d.equippedSkins] as Array<Record<string, unknown>>) {
+    if (!(OLD in rec)) continue;
+    if (!(NEW in rec)) rec[NEW] = rec[OLD];
+    delete rec[OLD];
+    changed = true;
+  }
+  // These records describe Magma-only content and must not unlock future Wax content.
+  for (const rec of [d.owned, d.active, d.unlockedPerks, d.equippedPerks, d.masteryProgress, d.masteryEnabled, d.masteryBinds] as Array<Record<string, unknown>>) {
+    if (OLD in rec) { delete rec[OLD]; changed = true; }
+  }
+  const renameList = (list: string[]): void => {
+    for (let i = list.length - 1; i >= 0; i--) {
+      if (list[i] !== OLD) continue;
+      if (list.includes(NEW)) list.splice(i, 1); else list[i] = NEW;
+      changed = true;
+    }
+  };
+  for (const list of [d.unlockedElements, d.gauntletsCompleted, d.gauntletsCompletedHard, d.quantumBond]) renameList(list);
+  if (d.pendingUnstable) {
+    if (d.pendingUnstable.result === OLD) { d.pendingUnstable.result = NEW; changed = true; }
+    renameList(d.pendingUnstable.ingredients);
+  }
+  return changed;
+}

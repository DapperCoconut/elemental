-    fx.ring(ctx.cx, ctx.cy, 14, 120, CHK.orange, 620);
-    fx.ring(ctx.cx, ctx.cy, 14, 144, CHK.teal, 720);
-    tick(ctx, ctx.cx, ctx.cy - 50, '🎨 MASTERPIECE', CHK.teal);

+  }
+  if (slot.seenStoryBeats) {
+    const next = slot.seenStoryBeats.map((id) => {
+      const colon = id.lastIndexOf(':');
+      return colon < 0 ? rename(id) : `${id.slice(0, colon + 1)}${rename(id.slice(colon + 1))}`;
+    });
+    if (next.some((id, i) => id !== slot.seenStoryBeats![i])) {

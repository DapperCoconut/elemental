+/** Preserve campaign clears and stock from the element Chalk replaced. Safe to run on every
+ * load because `chalk` is no longer a valid world or item owner. */
+function migrateChalkWorld(slot: CampaignSlot): boolean {
+  const OLD = 'chalk';
+  const NEW = 'clay';
+  const rename = (id: string): string => id === OLD || id.startsWith(`${OLD}-`)
+    ? NEW + id.slice(OLD.length)
+    : id;
+  let changed = false;
+  const oldFights = slot.fightsCompleted?.[OLD];
+  if (oldFights) {
+    slot.fightsCompleted[NEW] = [...new Set([...(slot.fightsCompleted[NEW] ?? []), ...oldFights.map(rename)])];
+    delete slot.fightsCompleted[OLD];
+    changed = true;
+  }
+  for (const list of [slot.challengesCompleted, slot.gauntletsCompleted]) {
+    if (!list) continue;
+    for (let i = list.length - 1; i >= 0; i--) {
+      if (list[i] !== OLD) continue;
+      if (list.includes(NEW)) list.splice(i, 1); else list[i] = NEW;
+      changed = true;
+    }
+  }
+  if (slot.seenStoryBeats) {
+    const next = slot.seenStoryBeats.map((id) => {
+      const colon = id.lastIndexOf(':');
+      return colon < 0 ? rename(id) : `${id.slice(0, colon + 1)}${rename(id.slice(colon + 1))}`;
+    });
+    if (next.some((id, i) => id !== slot.seenStoryBeats![i])) {
+      slot.seenStoryBeats = [...new Set(next)];
+      changed = true;
+    }
+  }
+  if (slot.inventory) {
+    const items: Record<string, string> = { 'gym-chalk': 'wet-clay', outline: 'kiln-shell', 'dust-cloud': 'slip' };
+    for (const [from, to] of Object.entries(items)) {
+      const held = slot.inventory[from];
+      if (!held) continue;
+      slot.inventory[to] = (slot.inventory[to] ?? 0) + held;
+      delete slot.inventory[from];
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+/** Preserve campaign clears and stock from the element Magma replaced. */
+function migrateMagmaWorld(slot: CampaignSlot): boolean {

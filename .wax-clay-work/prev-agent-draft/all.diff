-  // Chalk only flows while the button is held — the kit's own reason the work is not a slab.
-  pen(ctx, marks, {
-    startMs: 200, endMs: 200 + MP_MS, step: STEP_MP, color: CHK.green,
-    path: (t) => {
-      const a = t * Math.PI * 7.5;

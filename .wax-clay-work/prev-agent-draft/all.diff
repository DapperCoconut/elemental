-    for (const t of this.targetsOf(owner)) {
-      let covered = 0;
-      for (const m of run) {
-        if (Phaser.Math.Distance.Between(m.x, m.y, t.x, t.y) <= WARD_RADIUS) covered++;
-      }
-      if (covered === 0) continue;
-      if (time < (this.blastGate.get(t) ?? 0)) continue;
